# 複製成 .env 並填入實際值。.env 絕不進版控。

# SQLite(筆電開發):sqlite:///./helpdesk.db
# PostgreSQL(compose):由 compose.yaml 組出來指向 db 服務,不必在這裡填。
#   只有「在主機上直接連容器裡的資料庫」時才要 —— 例如跑搬遷腳本:
#   postgresql+psycopg://helpdesk:<密碼>@127.0.0.1:15432/helpdesk
DATABASE_URL=sqlite:///./helpdesk.db

# 憑證加密主金鑰。產生方式:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# LLM
OPENROUTER_API_KEY=
# 兩個都必須支援 tool calling(轉真人的 agent 層靠它)。openrouter/free 是
# 自動路由:請求帶 tools 時只會分到支援工具的模型。2026-09-24 實測一整天,
# 偏好模型每次都限流,真正在答的一直是它 —— 所以直接讓它當主要。
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# NVIDIA 自家 API(選填)。填了 NVIDIA 就當主要模型,OpenRouter 退成備援;
# 留空就只走 OpenRouter。2026-10-05 實測 10 題:super 轉真人 5/5、中位數 1.5 秒。
# 免費層每分鐘約 40 次、沒有每日上限(OpenRouter 免費是一天 50 次)。
# 到 https://build.nvidia.com 登入 → 產生 API key(nvapi- 開頭);產生時
# 服務要勾 Public API Endpoints。模型名不帶 :free —— 那是 OpenRouter 的命名。
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- compose 用 ---

# PostgreSQL 的密碼。自己想一個,不必是人記得住的。
POSTGRES_PASSWORD=

# ngrok 固定網域的 authtoken。對外的固定入口靠這個服務提供 —— 原本先試過
# Tailscale Funnel,網址本身是通的,但 LINE 的 TLS 客戶端跟它談不攏
# (握手到一半被掛斷,LINE 官方測試端點回 Session protocol negotiation
# failure),換成 ngrok 才真的通(見 docs/report.md 第七節)。
# 到 https://dashboard.ngrok.com/get-started/your-authtoken 取得。
# 免費層有 20,000 requests/月、1GB/月的硬上限。
NGROK_AUTHTOKEN=
