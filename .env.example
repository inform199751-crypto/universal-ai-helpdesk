# 複製成 .env 並填入實際值。.env 絕不進版控。

# SQLite(筆電開發):sqlite:///./helpdesk.db
# PostgreSQL(compose):由 compose.yaml 組出來指向 db 服務,不必在這裡填。
#   只有「在主機上直接連容器裡的資料庫」時才要 —— 例如跑搬遷腳本:
#   postgresql+psycopg://helpdesk:<密碼>@localhost:15432/helpdesk
DATABASE_URL=sqlite:///./helpdesk.db

# 憑證加密主金鑰。產生方式:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# 偏好模型滿載時自動改用這個。openrouter/free 是自動路由,OpenRouter 會挑
# 一個當下活著的免費模型。免費供應商滿載是常態,不是例外。
OPENROUTER_FALLBACK_MODEL=openrouter/free

# --- compose 用 ---

# PostgreSQL 的密碼。自己想一個,不必是人記得住的。
POSTGRES_PASSWORD=

# Tailscale auth key(Task 6 才會用到)。
# 必須是帶 tag:helpdesk 的 key —— 標記過的節點不適用金鑰到期,
# 沒打 tag 的話 180 天後某一天服務會自己斷線,而且你不會知道為什麼。
TS_AUTHKEY=
