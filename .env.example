# 複製成 .env 並填入實際值。.env 絕不進版控。

# SQLite(開發):sqlite:///./helpdesk.db
# PostgreSQL(正式):postgresql+psycopg://user:pass@localhost:5432/helpdesk
DATABASE_URL=sqlite:///./helpdesk.db

# 憑證加密主金鑰。產生方式:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# 偏好模型滿載時自動改用這個。openrouter/free 是自動路由,OpenRouter 會挑
# 一個當下活著的免費模型。免費供應商滿載是常態,不是例外。
OPENROUTER_FALLBACK_MODEL=openrouter/free
